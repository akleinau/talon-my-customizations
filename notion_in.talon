app: notion


-

page:
	key(ctrl-n)

tab new:
	key(ctrl-t)

tab close:
	key(ctrl-w)

go back:
	key(alt-left)

go next:
	key(alt-right)

reload:
	key(ctrl-r)

dark mode:
	key(ctrl-shift-l)

move page:
	key(ctrl-shift-p)

keyboard shortcuts:
	key(ctrl-alt-#)

toggle sidebar:
	key(ctrl-.)

search:
	key(ctrl-p)

heading:
	insert("# ")

sub heading:
	insert("## ")

sub sub heading:
	insert("### ")

bullet:
	insert("- ")

todo:
	insert("- [ ] ")

quote:
	insert("> ")

code block:
	insert("```\n\n```")
	key(up)

link:
	key(ctrl-k)

duplicate:
	key(ctrl-d)

move up:
	key(alt-up)

move down:
	key(alt-down)

delete line:
	key(ctrl-shift-k)
