nope: key('backspace')

nono: key('delete')

clock down: key("ctrl-z")

clock up: key("ctrl-y")

block: key('ctrl-shift-left') 

blow: key('ctrl-shift-right')

last: key("left")

next: key("right")

hop: key('ctrl-left')

hippo: key('ctrl-right')

copy: key('ctrl-c')
paste: key('ctrl-v')

yes: key("enter")