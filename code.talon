title: /Code/

click explorer: key(ctrl-shift-e)

confetti: 
    user.vscode('cursorless.toggleDecorations')

show pdf:
    key(ctrl-alt-v) 

dark mode:
    user.vscode('workbench.action.toggleLightDarkThemes')

open chat: 
    key(ctrl-alt-i)

(close chat)| (render pdf):
    key(ctrl-alt-b)

make bold:
    key("{")
    key("left")
    key("left")
    insert("\\textbf") 

make Italy:
    key("{")
    key("left")
    key("left")
    insert("\\textit")

make code:
    key("{")
    key("left")
    key("left")
    insert("\\textsc")
