nope: key('backspace')

nono: key('delete')

clock down: key("ctrl-z")

clock up: key("ctrl-y")

block: key('ctrl-shift-left') 

blow: key('ctrl-shift-right')

last: key("left")

next: key("right")

hops: key('ctrl-left')

hippo: key('ctrl-right')

copy: key('ctrl-c')
paste: key('ctrl-v')

yes: key("enter")

dubyes| ohyes: key("ctrl-enter")

scroll: user.mouse_scroll_down_continuous()

scrollo: user.mouse_scroll_up_continuous()